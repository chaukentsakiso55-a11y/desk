old = r'''        storeInstalledPackages().forEach { packageName ->
            val listFile = File(prefixDir, "var/lib/dpkg/info/$packageName.list")
            if (!listFile.isFile) return@forEach
            listFile.readLines()
                .filter { it.contains("/share/applications/") && it.endsWith(".desktop") }
                .map { File(it).name }
                .distinct()
                .forEach { desktopName ->
                    val source = File(appDir, desktopName)
                    if (!source.isFile) return@forEach
                    if (Regex("(?im)^NoDisplay=true\\s*${'$'}").containsMatchIn(source.readText())) return@forEach
                    val safePackage = packageName.replace(Regex("[^A-Za-z0-9_.-]"), "_")
                    val target = File(desktopDir, "DroidDesk-App-$safePackage-$desktopName")
                    source.copyTo(target, overwrite = true)
                    target.setExecutable(true, false)
                }
        }
'''
new = r'''        appDir.listFiles { file -> file.isFile && file.extension == "desktop" }
            ?.forEach { source ->
                val contents = runCatching { source.readText() }.getOrDefault("")
                if (Regex("(?im)^NoDisplay=true\\s*${'$'}").containsMatchIn(contents)) return@forEach
                if (Regex("(?im)^Hidden=true\\s*${'$'}").containsMatchIn(contents)) return@forEach
                val target = File(desktopDir, "DroidDesk-App-${source.name}")
                source.copyTo(target, overwrite = true)
                target.setExecutable(true, false)
            }
'''
